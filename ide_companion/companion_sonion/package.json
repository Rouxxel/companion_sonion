{
  "name": "companion-sonion",
  "displayName": "Companion Sonion",
  "description": "A VS Code extension that brings animated companions into your editor. Spawn, customize, and manage multiple GIF/PNG/WebM companions that persist across sessions.",
  "version": "0.1.2",
  "publisher": "Rouxxel",
  "engines": {
    "vscode": "^1.120.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rouxxel/companion_sonion/tree/main/ide_companion/companion_sonion"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "companion.helloWorld",
        "title": "Your companion is here!"
      },
      {
        "command": "companion.spawn",
        "title": "Spawn Companion"
      },
      {
        "command": "companion.spawnExplorer",
        "title": "Companion: Spawn In Explorer"
      },
      {
        "command": "companion.moveToExplorer",
        "title": "Companion: Move To Explorer"
      },
      {
        "command": "companion.moveToPanel",
        "title": "Companion: Move To Panel"
      },
      {
        "command": "companion.saveProfile",
        "title": "Save Companion Profile"
      },
      {
        "command": "companion.loadProfile",
        "title": "Load Companion Profile"
      },
      {
        "command": "companion.exportWorld",
        "title": "Export Companion World"
      },
      {
        "command": "companion.importWorld",
        "title": "Import Companion World"
      }
    ],

    "viewsContainers": {
      "activitybar": [
        {
          "id": "codingCompanion",
          "title": "Companion",
          "icon": "media/icon.png"
        }
      ]
    },

    "views": {
      "codingCompanion": [
        {
          "type": "webview",
          "id": "companionSidebar",
          "name": "Companion Settings",
          "icon": "media/icon.png"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "companionExplorer",
          "name": "Companion Sonion",
          "icon": "media/icon.png"
        }
      ]
    }
  }
}
