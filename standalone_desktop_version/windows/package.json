{
  "name": "companion-sonion-desktop",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "A minimal, taskbar-free desktop companion player.",
  "author": "Rouxxel",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --win nsis",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:dir": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.sonion.companion",
    "productName": "Sonion Companion",
    "copyright": "Copyright © 2026 Rouxxel",
    "directories": {
      "output": "release",
      "buildResources": "resources/build"
    },
    "files": [
      "dist/**/*",
      "!dist/test/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sonion Companion",
      "uninstallDisplayName": "Sonion Companion",
      "artifactName": "SonionCompanion-Setup-${version}.${ext}",
      "include": "resources/build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "SonionCompanion-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.5.0",
    "typescript": "^5.8.0"
  }
}
